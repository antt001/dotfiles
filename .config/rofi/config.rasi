/* rofi 2.0 configuration — Catppuccin Mocha.
 *
 * Note on how this works: rofi always merges its built-in default theme, which
 * is Solarized-light and resolves element colours through named variables
 * (background, foreground, lightbg, normal-background, ...). Defining only a
 * custom palette is not enough — the rows stay cream. The block below
 * redefines rofi's standard variable names, so the default theme's structure
 * resolves to Mocha, and then overrides the geometry.
 *
 * Palette matches .config/hypr/themes/catppuccin/mocha.lua
 * Geometry matches hyprland's decoration: rounding 5, border_size 2.
 *
 * Verify changes with:  rofi -dump-theme | awk '/^element normal.normal/,/^}/'
 */

configuration {
    modes:               "drun,run,window";
    show-icons:          true;
    terminal:            "kitty";
    drun-display-format: "{name}";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
}

* {
    /* Catppuccin Mocha */
    base:     #1e1e2e;
    mantle:   #181825;
    crust:    #11111b;
    surface0: #313244;
    surface1: #45475a;
    text:     #cdd6f4;
    subtext0: #a6adc8;
    overlay0: #6c7086;
    mauve:    #cba6f7;
    maroon:   #eba0ac;
    red:      #f38ba8;
    blue:     #89b4fa;

    /* rofi's standard names — these are what the default theme references */
    background: @base;
    foreground: @text;
    lightbg:    @surface0;
    lightfg:    @subtext0;

    normal-background:           @base;
    normal-foreground:           @text;
    alternate-normal-background: @mantle;
    alternate-normal-foreground: @text;
    selected-normal-background:  @surface0;
    selected-normal-foreground:  @mauve;

    urgent-background:           @base;
    urgent-foreground:           @red;
    alternate-urgent-background: @mantle;
    alternate-urgent-foreground: @red;
    selected-urgent-background:  @red;
    selected-urgent-foreground:  @base;

    active-background:           @base;
    active-foreground:           @blue;
    alternate-active-background: @mantle;
    alternate-active-foreground: @blue;
    selected-active-background:  @blue;
    selected-active-foreground:  @base;

    separatorcolor: @surface0;
    border-color:   @mauve;

    background-color: transparent;
    text-color:       @text;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    width:            600px;
    background-color: @base;
    border:           2px;
    border-color:     @mauve;
    border-radius:    5px;
}

mainbox {
    padding:  12px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @mantle;
    text-color:       @text;
    border-radius:    5px;
    padding:          10px 12px;
    spacing:          8px;
    children:         [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color:       @maroon;
}

entry {
    background-color:  transparent;
    text-color:        @text;
    placeholder:       "Search";
    placeholder-color: @overlay0;
    cursor:            text;
}

listview {
    background-color: transparent;
    lines:            8;
    columns:          1;
    scrollbar:        false;
    fixed-height:     false;
    padding:          12px 0 0 0;
    spacing:          4px;
}

element {
    padding:       8px 10px;
    border-radius: 5px;
    spacing:       10px;
    cursor:        pointer;
}

/* Explicit, so nothing depends on the default theme's indirection */
element normal.normal    { background-color: @base;     text-color: @text;  }
element alternate.normal { background-color: @mantle;   text-color: @text;  }
element selected.normal  { background-color: @surface0; text-color: @mauve; }

element-icon {
    background-color: transparent;
    size:             22px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    vertical-align:   0.5;
    text-color:       inherit;
}

message {
    padding:          10px;
    border-radius:    5px;
    background-color: @mantle;
}

error-message {
    padding:          12px;
    border-radius:    5px;
    background-color: @mantle;
    text-color:       @red;
}
